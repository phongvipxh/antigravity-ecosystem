{
  "mcpServers": {
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless"
      ]
    },
    "openspace": {
      "command": "C:/Users/lucaha/OpenSpace/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "openspace.entrypoints.mcp.server",
        "--transport",
        "stdio"
      ],
      "env": {
        "OPENSPACE_WORKSPACE": "C:/Users/lucaha/OpenSpace",
        "OPENSPACE_HOST_SKILL_DIRS": "C:/Users/lucaha/.gemini/config/skills",
        "OPENSPACE_CLOUD_MODE": "local"
      }
    }
  }
}
